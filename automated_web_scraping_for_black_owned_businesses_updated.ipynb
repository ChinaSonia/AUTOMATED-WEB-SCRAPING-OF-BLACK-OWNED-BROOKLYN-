"""Scrape business listings from paginated (infinite-scroll) category pages.
 
Pipeline: Selenium scrolls each category page until no new content loads,
BeautifulSoup collects listing links, each listing page is fetched once and
parsed into structured fields (name, address, phone, website), then saved
as one CSV per category plus a combined, de-duplicated file.
"""
import re
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen
 
import pandas as pd
from bs4 import BeautifulSoup
%pip install selenium beautifulsoup4 pandas
%pip install --upgrade selenium
from selenium import webdriver

BASE_URL = "https://www.blackownedbrooklyn.com"
CATEGORIES = [
    "History and Culture",
    "Food and Drink",
    "Home and Design",
    "Style and Beauty",
    "Health and Wellness",
]
COLUMNS = ["category", "business_url", "name", "address", "phone",
           "website", "closed", "is_business"]
 
PHONE_RE = re.compile(r"\(?\d{3}\)?[\s.\-]*\d{3}[\s.\-]*\d{4}")
WEBSITE_RE = re.compile(r"\b(?:www\.)?[\w\-]+\.(?:com|nyc|co|shop|life|org|net)\b", re.I)
ADDRESS_RE = re.compile(
    r"\d+[A-Z]?\s+[\w.'\s]+?(?:Ave|Avenue|St|Street|Blvd|Boulevard|Pl|Place|Rd|Road|Dr|Drive)\b\.?",
    re.I,
)

def fetch_soup(url):
    """Fetch a page once and return parsed HTML, or None on failure."""
    request = Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urlopen(request, timeout=15) as response:
            return BeautifulSoup(response.read(), "html.parser")
    except (HTTPError, URLError, TimeoutError):
        return None

def get_listing_links(browser, category_url, pause=3):
    """Scroll until the page height stops growing, then collect listing links."""
    browser.get(category_url)
    last_height = 0
    while True:
        browser.execute_script("window.scrollTo(0, document.body.scrollHeight);")
        time.sleep(pause)
        height = browser.execute_script("return document.body.scrollHeight")
        if height == last_height:
            break
        last_height = height
    soup = BeautifulSoup(browser.page_source, "html.parser")
    links = [a["href"] for a in soup.find_all("a", class_="u-url") if a.get("href")]
    return list(dict.fromkeys(links))  # de-duplicate, keep order

def normalise_phone(raw):
    digits = re.sub(r"\D", "", raw)
    return f"{digits[:3]}-{digits[3:6]}-{digits[6:]}" if len(digits) == 10 else raw.strip()
 
 
def parse_listing(url):
    """Parse one listing page into a structured record."""
    soup = fetch_soup(url)
    if soup is None:
        return None
    name = None
    if soup.title:
        name = soup.title.get_text(strip=True).replace("— Black-Owned Brooklyn", "").strip()
    text = " ".join(em.get_text(" ", strip=True) for em in soup.find_all("em"))
    phones = list(dict.fromkeys(normalise_phone(p) for p in PHONE_RE.findall(text)))
    addresses = list(dict.fromkeys(a.strip() for a in ADDRESS_RE.findall(text)))
    websites = list(dict.fromkeys(w.lower() for w in WEBSITE_RE.findall(text)))
    return {
        "business_url": url,
        "name": name,
        "address": " | ".join(addresses),
        "phone": " | ".join(phones),
        "website": " | ".join(websites),
        "closed": "has closed" in text.lower(),
        "is_business": bool(phones or addresses or websites),
    }

def scrape_category(browser, category):
    url = f"{BASE_URL}/stories?category={quote(category)}"
    rows = []
    for link in get_listing_links(browser, url):
        record = parse_listing(BASE_URL + link)
        if record:
            record["category"] = category
            rows.append(record)
    return pd.DataFrame(rows, columns=COLUMNS)

def main(output_dir="output"):
    out = Path(output_dir)
    out.mkdir(exist_ok=True)
    browser = webdriver.Chrome()
    frames = []
    try:
        for category in CATEGORIES:
            df = scrape_category(browser, category)
            slug = category.lower().replace(" ", "_")
            df.to_csv(out / f"{slug}.csv", index=False, encoding="utf-8-sig")
            frames.append(df)
    finally:
        browser.quit()
    combined = pd.concat(frames, ignore_index=True).drop_duplicates(subset="business_url")
    combined.to_csv(out / "all_listings.csv", index=False, encoding="utf-8-sig")
    combined[combined["is_business"]].to_csv(
        out / "businesses_clean.csv", index=False, encoding="utf-8-sig"
    )
    print(f"Scraped {len(combined)} unique pages; "
          f"{int(combined['is_business'].sum())} contain business contact details.")
 
 
if __name__ == "__main__":
    main()
